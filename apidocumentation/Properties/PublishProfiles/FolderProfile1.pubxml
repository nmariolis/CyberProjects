<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>C:\CyberProjects\Publisedwww</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <!--
      Runtime-mutated state that the deployed server owns. Excluding it from the
      publish package means a redeploy won't overwrite live data:
        • users.json                    — registered/approved user accounts
        • pendingFieldDescriptions.json — transient field-edit approval queue
        • serviceFieldAssignments.json  — admin field→service assignments (source of truth)
      Excluded folder:
        • Models\XSDs\XSDs\Requests     — request XSDs are admin-editable. The
          field-assignment feature patches them in place, and CreateService writes
          uploaded schemas into Requests\Custom\. Freezing the folder keeps those
          admin edits from being clobbered on redeploy.
      First-time deploy: the runtime creates the JSON files on demand, so missing
      files are fine. The request XSDs, though, are seed content — after the first
      publish to a brand-new server, copy the Requests folder in manually once.
    -->
    <ExcludeFilesFromDeployment>Models\users.json;Models\pendingFieldDescriptions.json;Models\serviceFieldAssignments.json</ExcludeFilesFromDeployment>
    <ExcludeFoldersFromDeployment>Models\XSDs\XSDs\Requests</ExcludeFoldersFromDeployment>
  </PropertyGroup>
</Project>