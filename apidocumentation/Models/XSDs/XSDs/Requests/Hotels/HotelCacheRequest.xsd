<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="HotelCacheRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Username" type="xs:string" minOccurs="1" maxOccurs="1" default="username" xmlns:doc="Customer's username."/>
        <xs:element name="Password" type="xs:string" minOccurs="1" maxOccurs="1" default="password" xmlns:doc="Customer's password."/>
        <xs:element name="HotelID" type="xs:int" minOccurs="1" maxOccurs="1" xmlns:doc="The unique identifier of the hotel whose cached rates you want to retrieve."/>
        <xs:element name="Duration" type="xs:int" minOccurs="1" maxOccurs="1" xmlns:doc="Number of nights for the stay. Used to calculate the total rate from the cached pricing data."/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
