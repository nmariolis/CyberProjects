<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="SearchHotelsRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Username" type="xs:string" minOccurs="1" maxOccurs="1" default="username" xmlns:doc="Customer's username"/>
        <xs:element name="Password" type="xs:string" minOccurs="1" maxOccurs="1" default="password" xmlns:doc="Customer’s password"/>
        <xs:element name="BookDate" type="xs:date" minOccurs="0" maxOccurs="1" xmlns:doc="The date the booking is made. Used to apply early-booking discounts or advance-purchase rates." />
        <xs:element name="OnRequest" type="xs:boolean" minOccurs="0" maxOccurs="1" xmlns:doc="When true, includes on-request hotels and rooms in the search results." />
        <xs:element name="ShowVarious" type="xs:boolean" minOccurs="0" maxOccurs="1" xmlns:doc="When true, returns all available room and board options per hotel, not just the cheapest." />
        <xs:element name="ShowCancellationFees" type="xs:boolean" minOccurs="0" maxOccurs="1" xmlns:doc="When true, includes cancellation policy fee details in the response." />
        <xs:element name="NoCache" type="xs:boolean" minOccurs="0" maxOccurs="1" xmlns:doc="When true, bypasses cached data and fetches live availability directly from the system." />
        <xs:element name="Extranet" type="xs:boolean" minOccurs="0" maxOccurs="1" xmlns:doc="When true, switches to extranet pricing mode." />
        <xs:element name="IgnoreTariff" type="xs:boolean" minOccurs="0" maxOccurs="1" xmlns:doc="When true, ignores your assigned tariff and returns rates from all available contracts." />
        <xs:element name="GroupRoomBoards" type="xs:boolean" minOccurs="0" maxOccurs="1" xmlns:doc="When true, groups response results by room and board type combinations." />
        <xs:element name="DateFrom" type="xs:date" minOccurs="1" maxOccurs="1" fixed="2020-06-01" xmlns:doc="Start date of the party’s stay. "/>
        <xs:element name="DateTo" type="xs:date" minOccurs="1" maxOccurs="1" fixed="2020-06-15" xmlns:doc="End date of the party’s stay. "/>
        <xs:element name="Rooms" minOccurs="1" maxOccurs="4" xmlns:doc="The number of rooms and their occupants (see below). ">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Room" type="RoomType" minOccurs="1" maxOccurs="4" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Language" minOccurs="1" default="en" xmlns:doc="2 character string that specifies your chosen language. Contact your xml provider for available languages.">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="en|de|fr|zh|nl" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Board" minOccurs="0" maxOccurs="1" xmlns:doc="2 character string that specifies which boarding you are searching for. RR = Room Rates, BB = Bed and Breakfast, HB = Half Board, FB = Full Board, AI = All Inclusive, UI = Ultra All Inclusive ">
          <xs:simpleType>
            <xs:restriction base="xs:string" >
              <xs:pattern value="RR|BB|HB|FB|AI|UI" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="HotelID" type="xs:int" minOccurs="0" maxOccurs="1" xmlns:doc="Show prices and availability for this hotel only. "/>
        <xs:element name="HotelName" type="xs:string" minOccurs="0" maxOccurs="1" xmlns:doc="Search for a hotel or any hotel names that contain a specific string. "/>
        <xs:element name="RoomName" type="xs:string" minOccurs="0" maxOccurs="1" xmlns:doc="Search for hotels that have a certain type of room "/>
        <xs:element name="Hoteltype" minOccurs="0" maxOccurs="1" xmlns:doc="H = Hotels only, A = Apartments only, V = Villas only, U = All Selfcatering accommodation. Returns all types when left null. ">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="H" />
              <xs:enumeration value="A" />
              <xs:enumeration value="V" />
              <xs:enumeration value="U" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Location" type="xs:int" minOccurs="0" maxOccurs="1" xmlns:doc="Location type id (Beach Hotels, City Hotels, Resorts) ">
          <xs:annotation>
            <xs:documentation>
              See LocationCategories for information on how to obtain these IDs
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Rating" minOccurs="0" maxOccurs="1" xmlns:doc="5 = Lux or 5 stars, 4 = A Category or 4 stars, 3 = B Category or 3 stars, 2 = C Category or 2 stars, 1 = D Category or 1 star. Returns all ratings when left null. ">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="1" />
              <xs:maxInclusive value="5" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Country" minOccurs="0" maxOccurs="1" xmlns:doc="2 character string that specifies which country you want to search in. ">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="GR|CY" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Province" type="xs:int" minOccurs="0" maxOccurs="1"  xmlns:doc="Returns hotels in the specified Province ID">
          <xs:annotation>
            <xs:documentation>See PlaceSearch for information on how to obtain these IDs</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Prefecture" type="xs:int" minOccurs="0" maxOccurs="1" xmlns:doc="Returns hotels in the specified Prefecture ID ">
          <xs:annotation>
            <xs:documentation>See PlaceSearch for information on how to obtain these IDs</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="City" type="xs:int" minOccurs="0" maxOccurs="1"  xmlns:doc="Returns hotels in the specified City ID">
          <xs:annotation>
            <xs:documentation>See PlaceSearch for information on how to obtain these IDs</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="UseTariff" type="xs:boolean" minOccurs="0" xmlns:doc="When true, returns prices and availability based on your assigned tariff. When false, will return your own contracts." />
        <xs:element name="IsOptimized" type="xs:boolean" minOccurs="0" xmlns:doc="When true, returns a faster, less detailed response. Recommended for search listings." />
        <xs:element name="Residency" minOccurs="0" maxOccurs="1" xmlns:doc="2-character ISO 3166-1 alpha-2 country code of the traveller's country of residence (e.g. GB, DE, GR). Used to apply residency-specific rates where applicable.">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z]{2}" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="RoomType">
    <xs:attribute name="Adults" fixed="2" use="required" xmlns:doc ="Number of adults allocated to this room.">
      <xs:simpleType>
        <xs:restriction base="xs:int">
          <xs:minInclusive value="1" />
          <xs:maxInclusive value="20" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="Children" fixed="0" xmlns:doc ="Number of children allocated to this room. Default is 0. ">
      <xs:simpleType>
        <xs:restriction base="xs:int">
          <xs:minInclusive value="0" />
          <xs:maxInclusive value="10" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ChildrenAges" fixed="" xmlns:doc="If the number of children is greater than 0, specify their ages with a comma separated list, i.e. ’12,9,5’ ">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="([0-9 ]{1,2}(,[0-9 ]{1,2})*)*" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
</xs:schema>