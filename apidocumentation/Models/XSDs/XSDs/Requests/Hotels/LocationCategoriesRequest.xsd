<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="LocationCategoriesRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element type="xs:string" name="Username" minOccurs="1" maxOccurs="1"  default="username" xmlns:doc="Customer's username"/>
        <xs:element type="xs:string" name="Password" minOccurs="1" maxOccurs="1" default="password" xmlns:doc="Customer's password" />
        <xs:element name="Language" minOccurs="0" maxOccurs="1" default="en" xmlns:doc="2 character string that specifies your chosen language.">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="en|de|fr|zh|nl" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>