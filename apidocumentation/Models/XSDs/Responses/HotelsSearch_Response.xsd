<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="SearchHotels">
    <xs:complexType>
      <xs:all>
        <xs:element name="Username" type="xs:string" minOccurs="1" maxOccurs="1" />
        <xs:element name="Password" type="xs:string" minOccurs="1" maxOccurs="1" />
        <xs:element name="DateFrom" type="xs:date" />
        <xs:element name="DateTo" type="xs:date" />
        <xs:element name="Rooms">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Room" type="RoomType" minOccurs="1" maxOccurs="4" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Language" default="en">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="en|de|fr|el|ru|it|es|nl" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Board" minOccurs="0" maxOccurs="1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="RR|BB|HB|FB|AI|UI" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="HotelID" type="xs:int" minOccurs="0" maxOccurs="1" />
        <xs:element name="HotelName" type="xs:string" minOccurs="0" maxOccurs="1" />
        <xs:element name="RoomName" type="xs:string" minOccurs="0" maxOccurs="1" />
        <xs:element name="Hoteltype" minOccurs="0" maxOccurs="1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="H" />
              <xs:enumeration value="A" />
              <xs:enumeration value="V" />
              <xs:enumeration value="U" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Location" type="xs:int" minOccurs="0" maxOccurs="1" />
        <xs:element name="Rating" minOccurs="0" maxOccurs="1">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="1" />
              <xs:maxInclusive value="5" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Country" minOccurs="0" maxOccurs="1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="EN|GR|CY|ES|IT|RU|FR|DE|BG" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Province" type="xs:int" minOccurs="0" maxOccurs="1" />
        <xs:element name="Prefecture" type="xs:int" minOccurs="0" maxOccurs="1" />
        <xs:element name="City" type="xs:int" minOccurs="0" maxOccurs="1" />
        <xs:element name="UseTariff" type="xs:boolean" minOccurs="0" />
        <xs:element name="IsOptimized" type="xs:boolean" minOccurs="0" />
        <xs:element name="Response" type="ResponseSchema" minOccurs="0" maxOccurs="1" />
        <xs:element name="ErrorList" type="ErrorListSchema" minOccurs="0" maxOccurs="1" />
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="RoomType">
    <xs:attribute name="Adults" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:int">
          <xs:minInclusive value="1" />
          <xs:maxInclusive value="20" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="Children" default="0">
      <xs:simpleType>
        <xs:restriction base="xs:int">
          <xs:minInclusive value="0" />
          <xs:maxInclusive value="10" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ChildrenAges">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="([0-9 ]{1,2}(,[0-9 ]{1,2})*)*" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ResponseSchema">
    <xs:all>
      <xs:element name="Hotels" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Hotel" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:all>
                  <xs:element name="Name" minOccurs="1" type="xs:string" />
                  <xs:element name="ImageThumbURL" minOccurs="0" type="xs:string" />
                  <xs:element name="Country" minOccurs="0" type="xs:string" />
                  <xs:element name="State" minOccurs="0" type="xs:int" />
                  <xs:element name="StateProvinceName" minOccurs="0" type="xs:string" />
                  <xs:element name="Prefecture" minOccurs="0" type="xs:int" />
                  <xs:element name="PrefectureName" minOccurs="0" type="xs:string" />
                  <xs:element name="City" minOccurs="0" type="xs:int" />
                  <xs:element name="CityName" minOccurs="0" type="xs:string" />
                  <xs:element name="Address1" minOccurs="0" type="xs:string" />
                  <xs:element name="Address2" minOccurs="0" type="xs:string" />
                  <xs:element name="Address3" minOccurs="0" type="xs:string" />
                  <xs:element name="Rating" minOccurs="0" type="xs:decimal" />
                  <xs:element name="Longitude" minOccurs="0" type="xs:decimal" />
                  <xs:element name="Latitude" minOccurs="0" type="xs:decimal" />
                  <xs:element name="Type" minOccurs="0" type="xs:int" />
                  <xs:element name="TypeDescription" minOccurs="0" type="xs:string" />
                  <xs:element name="Location" minOccurs="0" type="xs:int" />
                  <xs:element name="LocationDescription" minOccurs="0" type="xs:string" />
                  <xs:element name="OfficialRating" minOccurs="0" type="xs:string" />
                  <xs:element name="Description" minOccurs="0" type="xs:string" />
                  <xs:element name="LowRate" minOccurs="0" type="xs:decimal" />
                  <xs:element name="SpecialOffer" minOccurs="0" type="xs:boolean" />
                  <xs:element name="TravelAdvisor" minOccurs="0" type="xs:int" />
                  <xs:element name="Availability" minOccurs="0" type="xs:int" />
                  <xs:element name="LowestPrice" minOccurs="0" type="xs:decimal" />
                  <xs:element name="OfficialRating_ID" minOccurs="0" type="xs:int" />
                  <xs:element name="Property_Class_ID" minOccurs="0" type="xs:int" />
                  <xs:element name="HasAllInclusive" minOccurs="0" type="xs:boolean" />
                  <xs:element name="HasContinentalBreakfast" minOccurs="0" type="xs:boolean" />
                  <xs:element name="HasIndoorPool" minOccurs="0" type="xs:boolean" />
                  <xs:element name="HasOutdoorPool" minOccurs="0" type="xs:boolean" />
                  <xs:element name="HasDataPorts" minOccurs="0" type="xs:boolean" />
                  <xs:element name="HasFitnessFacility" minOccurs="0" type="xs:boolean" />
                  <xs:element name="HasSPAWellnessCentre" minOccurs="0" type="xs:boolean" />
                  <xs:element name="HasPetsAllowed" minOccurs="0" type="xs:boolean" />
                  <xs:element name="HasParkingGarage" minOccurs="0" type="xs:boolean" />

                  <xs:element name="Rooms" minOccurs="1">
                    <xs:complexType>
                      <xs:all>
                        <xs:element name="Rooms" minOccurs="1">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="Room" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                  <xs:sequence>
                                    <xs:element name="Name" minOccurs="1" type="xs:string" />
                                    <xs:element name="Occupancy" minOccurs="1" maxOccurs="4">
                                      <xs:complexType>
                                        <xs:all>
                                          <xs:element name="RR" minOccurs="1" type="RoomPriceSchema" />
                                          <xs:element name="BB" minOccurs="1" type="RoomPriceSchema" />
                                          <xs:element name="HB" minOccurs="1" type="RoomPriceSchema" />
                                          <xs:element name="FB" minOccurs="1" type="RoomPriceSchema" />
                                          <xs:element name="AI" minOccurs="1" type="RoomPriceSchema" />
                                          <xs:element name="UI" minOccurs="1" type="RoomPriceSchema" />
                                        </xs:all>
                                        <xs:attribute name="Code" use="required">
                                          <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                              <xs:pattern value="R1|R2|R3|R4" />
                                            </xs:restriction>
                                          </xs:simpleType>
                                        </xs:attribute>
                                        <xs:attribute name="MinLOSError" use="optional" type="xs:boolean" />
                                        <xs:attribute name="ReleaseError" use="optional" type="xs:boolean" />
                                        <xs:attribute name="Availability" use="required" type="xs:int" />
                                        <xs:attribute name="StopSales" use="optional" type="xs:boolean" />
                                        <xs:attribute name="ContractID" use="optional" type="xs:int" />
                                        <xs:attribute name="NonRefundable" use="optional" type="xs:int" />
                                      </xs:complexType>
                                    </xs:element>
                                  </xs:sequence>
                                  <xs:attribute name="ID" use="required" type="xs:int" />
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                          </xs:complexType>
                        </xs:element>
                      </xs:all>
                    </xs:complexType>
                  </xs:element>
                </xs:all>
                <xs:attribute name="ID" use="required" type="xs:int" />
                <xs:attribute name="giata_id" use="required" type="xs:int" />
                <xs:attribute name="Currency" use="required" type="xs:string" />
              </xs:complexType>
            </xs:element>
            <xs:element name="Results" minOccurs="0">
              <xs:complexType>
              <xs:all>
                <xs:element name="RecordCount" minOccurs="1" type="xs:int" />
                <xs:element name="CityResults" minOccurs="0">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="CityResult" minOccurs="1" maxOccurs="unbounded">
                        <xs:complexType>
                          <xs:all>
                            <xs:element name="City" minOccurs="1" type="xs:int" />
                            <xs:element name="CityName" minOccurs="1" type="xs:string" />
                            <xs:element name="Hotels" minOccurs="1" type="xs:int" />
                          </xs:all>
                        </xs:complexType>
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Facilities" minOccurs="1">
                  <xs:complexType>
                    <xs:all>
                      <xs:element name="AllInclusive" minOccurs="1" type="xs:int" />
                      <xs:element name="Breakfast" minOccurs="1" type="xs:int" />
                      <xs:element name="IndoorPool" minOccurs="1" type="xs:int" />
                      <xs:element name="OutdoorPool" minOccurs="1" type="xs:int" />
                      <xs:element name="InternetServices" minOccurs="1" type="xs:int" />
                      <xs:element name="FitnessFacility" minOccurs="1" type="xs:int" />
                      <xs:element name="SPAWellnessCentre" minOccurs="1" type="xs:int" />
                      <xs:element name="PetsAllowed" minOccurs="1" type="xs:int" />
                      <xs:element name="Parking" minOccurs="1" type="xs:int" />
                    </xs:all>
                  </xs:complexType>
                </xs:element>
                <xs:element name="PropertyTypes" minOccurs="1">
                  <xs:complexType>
                    <xs:all>
                      <xs:element name="Hotels" minOccurs="1" type="xs:int" />
                      <xs:element name="Apartments" minOccurs="1" type="xs:int" />
                      <xs:element name="Villas" minOccurs="1" type="xs:int" />
                    </xs:all>
                  </xs:complexType>
                </xs:element>
                <xs:element name="StarRatings" minOccurs="1">
                  <xs:complexType>
                    <xs:all>
                      <xs:element name="FiveStars" minOccurs="1" type="xs:int" />
                      <xs:element name="FourStars" minOccurs="1" type="xs:int" />
                      <xs:element name="ThreeStars" minOccurs="1" type="xs:int" />
                      <xs:element name="TwoStars" minOccurs="1" type="xs:int" />
                    </xs:all>
                  </xs:complexType>
                </xs:element>
              </xs:all>                
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="Records" use="optional" type="xs:int" />
          <xs:attribute name="Overnights" use="required" type="xs:int" />
          <xs:attribute name="NumberOfRooms" use="required" type="xs:int" />
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="RoomPriceSchema">
    <xs:all>
      <xs:element name="Discount" minOccurs="1" type="xs:decimal" />
      <xs:element name="value" minOccurs="1" type="xs:decimal" />
    </xs:all>
  </xs:complexType>

  <xs:complexType name="ErrorListSchema">
    <xs:all>
      <xs:element name="Errors" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="1" maxOccurs="unbounded" name="Error" type="xs:string" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Warnings" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="1" maxOccurs="unbounded" name="Warning" type="xs:string" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>
</xs:schema>
